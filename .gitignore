# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/

# Unity3D generated meta files that shouldn't be versioned individually are already covered by Library
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated VS/Rider/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressableAssetsData/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS / editor
.DS_Store
Thumbs.db
.vs/
.idea/

# Headless Unity batchmode debug logs (unity_*.log at repo root)
/unity_*.log

# Coplay package's own data (chat history, logs, local settings)
/Packages/Coplay/

# .NET test project for the engine-free core (tests/); keep its csproj despite the Unity rule above
!/tests/**/*.csproj
/tests/**/bin/
/tests/**/obj/

# Private design docs and research are excluded via .git/info/exclude (local only).

# Private/local-only store & marketing assets (mirrored to private Eren-Ozcan/pictures repo)
docs/store-assets-originals/

# Android release signing keystore (never public)
android-keystore/

# Unity Android build temp cache
.utmp/

# Local Claude Code settings
.claude/settings.local.json

# Android upload keystore and its password (backup in the private pictures repo)
/android-keystore/

# Firebase Unity SDK tarballs (62 MB); fetched by scripts/fetch-firebase.sh
/Packages/firebase/

# Firebase AARs the External Dependency Manager copies from the packages on every resolve
/Assets/GeneratedLocalRepo/
/Assets/GeneratedLocalRepo.meta

# Firebase config holds the project API key; the repo is public, backup lives in the private
# pictures repo. The androidlib folders are regenerated from google-services.json on import.
/Assets/google-services.json
/Assets/google-services.json.meta
/Assets/StreamingAssets/google-services-desktop.json
/Assets/StreamingAssets/google-services-desktop.json.meta
/Assets/Plugins/Android/FirebaseApp.androidlib/
/Assets/Plugins/Android/FirebaseApp.androidlib.meta
/Assets/Plugins/Android/FirebaseCrashlytics.androidlib/
/Assets/Plugins/Android/FirebaseCrashlytics.androidlib.meta
